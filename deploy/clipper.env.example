# 独立配额，0 表示不限量。文本模型默认沿用站内专用配置。
GRASPMEMOEDU_CLIPPER_DAILY_ACCOUNT=0
GRASPMEMOEDU_CLIPPER_DAILY_GLOBAL=0
# GRASPMEMOEDU_CLIPPER_BASE_URL=
# GRASPMEMOEDU_CLIPPER_MODEL=
# GRASPMEMOEDU_CLIPPER_API_KEY=
# GRASPMEMOEDU_CLIPPER_IMAGE_MODEL=

# 站点语音服务，使用已获准向登录账号提供的凭据。
# GRASPMEMOEDU_CLIPPER_SPEECH_BASE_URL=https://api.xiaomimimo.com/v1
# GRASPMEMOEDU_CLIPPER_SPEECH_MODEL=mimo-v2.5-tts
# GRASPMEMOEDU_CLIPPER_SPEECH_API_KEY=
# 使用独立 SSH 转发时，站点默认 OpenAI 朗读通过回环端口建立 TLS。
# GRASPMEMOEDU_CLIPPER_SPEECH_BASE_URL=https://api.openai.com/v1
# GRASPMEMOEDU_CLIPPER_SPEECH_MODEL=gpt-realtime-2.1-mini
# GRASPMEMOEDU_CLIPPER_OPENAI_SSH_PORT=18773

# 站点 OCR 服务。
# GRASPMEMOEDU_CLIPPER_OCR_BASE_URL=
# GRASPMEMOEDU_CLIPPER_OCR_MODEL=
# GRASPMEMOEDU_CLIPPER_OCR_API_KEY=
# To use the desktop MinerU runner on this server, install it at an absolute path.
# GRASPMEMOEDU_CLIPPER_MINERU_RUNNER=
# MINERU_API_TOKEN=

# 每一站点独立生成，以 Base64 表示的 32 字节随机值。保存在服务器私有环境文件及密钥备份。
# GRASPMEMOEDU_CLIPPER_VAULT_KEY=
